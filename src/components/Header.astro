---
type Author = {
  name: string;
  url?: string;
  institution?: string;
  notes?: string[];
};

type Note = {
  symbol: string;
  text: string;
};

type Link = {
  url: string;
  name: string;
};

interface Props {
  title: string;
  authors: Author[];
  conference?: string;
  notes?: Note[];
  links?: Link[];
}

const { title, authors, conference, notes, links } = Astro.props;

const hasBackground = Astro.slots.has("background");
---

<header
  class:list={[
    "paper-header full-bleed relative mb-12",
    hasBackground && "-mt-16 pt-24 pb-20",
  ]}
>
  {
    hasBackground && (
      <div class="cover absolute inset-0 z-0 overflow-hidden">
        <slot name="background" />
        <div class="header-cover-overlay absolute inset-0" />
      </div>
    )
  }
  <div
    class:list={[
      "relative z-10 mx-auto flex max-w-[50rem] flex-col items-center px-6 text-center",
      "gap-6",
    ]}
  >
    {conference && <div class="conference-pill">{conference}</div>}
    <h1 class="paper-title my-0 text-5xl font-medium">{title}</h1>
    <div class="flex flex-row flex-wrap justify-center gap-x-8 gap-y-4">
      {
        authors.map((author) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex flex-row text-xl">
              {author.url ? (
                <a href={author.url}>{author.name}</a>
              ) : (
                author.name
              )}
              {author.notes && (
                <sup class="text-xl">
                  {author.notes.map(
                    (note, index, array) =>
                      note + (index < array.length - 1 ? "," : ""),
                  )}
                </sup>
              )}
            </div>
            {author.institution && <div>{author.institution}</div>}
          </div>
        ))
      }
    </div>
    {
      notes && (
        <div class="text-center text-sm">
          {
            // prettier-ignore
            notes.map((note, index, array) => (
              <span>
                <sup>{note.symbol}</sup>{note.text}{index < array.length - 1 ? "," : ""}
              </span>
            ))
          }
        </div>
      )
    }
    {
      links && (
        <div class="not-prose flex flex-row flex-wrap justify-center gap-2">
          {links.map((link) => (
            <a
              href={link.url}
              class="paper-link flex flex-row items-center gap-2 rounded-full px-5 py-2 text-lg hover:no-underline"
            >
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Make the slotted cover (Picture/Video, or a plain <img>/<video>) fill the
     header, overriding those components' figure styling. Scoped to `.cover`.
     Kept as scoped CSS because expressing it with Tailwind would require
     repeating the descendant variant on every declaration. */
  .cover :global(:is(picture, img, video)) {
    position: absolute;
    inset: 0;
    /* Zero the margin that `prose` adds to media elements, which would
       otherwise push the cover down and expose the page background. */
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center 48%;
    border-radius: 0;
    filter: blur(12px) saturate(0.78) contrast(0.9);
    opacity: 0.7;
    transform: scale(1.06);
  }

  .header-cover-overlay {
    background:
      linear-gradient(90deg, rgba(245, 248, 251, 0.88) 0%, rgba(245, 248, 251, 0.62) 52%, rgba(245, 248, 251, 0.76) 100%),
      linear-gradient(180deg, rgba(245, 248, 251, 0.28) 0%, rgba(245, 248, 251, 0.54) 62%, #f5f8fb 100%);
  }
</style>
